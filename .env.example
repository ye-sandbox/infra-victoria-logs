# ==============================================================================
# ENVIRONMENT VARIABLES: VICTORIALOGS + VECTOR HOMELAB STACK
# ==============================================================================
# Copie este arquivo para `.env` e configure conforme seu ambiente:
# cp .env.example .env
# ==============================================================================

# Nome do projeto no Docker Compose
COMPOSE_PROJECT_NAME=observability

# Identificador do host atual nos logs (ex: mini-pc-proxmox, nuc-01)
HOST_IDENTIFIER=mini-pc-proxmox

# ==============================================================================
# STORAGE PROFILE (hdd | ssd)
# ==============================================================================
# Escolha o perfil adequado à mídia de armazenamento do seu Mini PC / Servidor:
#
# - hdd: OTIMIZADO PARA DISCOS MECÂNICOS (HD SATA / USB)
#        * Buffer do Vector em memória RAM (elimina a escrita dupla no HD)
#        * Lotes maiores (2 MB / 15s) para maximizar escrita sequencial e cortar I/O contínuo
#        * Descarte automático de pings/healthchecks para poupar IOPS
#        * Concorrência de busca reduzida para não travar a agulha de leitura
#
# - ssd: OTIMIZADO PARA SSDs / NVMes
#        * Buffer persistente em disco (256 MB) para máxima durabilidade
#        * Lotes menores (1 MB / 1s) para menor latência de visualização
#        * Ingestão completa de logs
#        * Suporta mais buscas concorrentes simultâneas
#
# - geoip: ENRIQUECIMENTO GEOGRÁFICO DE TRÁFEGO WEB (Nginx / Traefik / Caddy)
#        * Realiza lookup em tempo real no banco MaxMind GeoLite2-City (.mmdb)
#        * Adiciona país, cidade, ISO code e coordenadas para IPs públicos
#        * Requer download prévio via ./scripts/download-geolite2.sh
#
STORAGE_PROFILE=hdd

# Concorrência máxima de buscas no VictoriaLogs (recomendado: 2 para hdd, 4 para ssd)
VL_MAX_CONCURRENT_REQUESTS=2

# Duração máxima para abortar buscas lentas (protege contra travamentos)
VL_MAX_QUERY_DURATION=30s

# Intervalo para consolidar dados na RAM antes de descarregar peças para o disco
# Recomendado: 15s para hdd (reduz merges de pequenas peças no HD), 5s para ssd
VL_INMEMORY_FLUSH_INTERVAL=15s

# ==============================================================================
# SECURITY / BASIC AUTH (Opcional)
# ==============================================================================
# Se preenchido, protege a Web UI (VMUI), endpoint de ingestão e APIs do VictoriaLogs
# com autenticação HTTP básica. Se deixado vazio, a autenticação fica desativada.
# VICTORIALOGS_AUTH_USERNAME=admin
# VICTORIALOGS_AUTH_PASSWORD=altere_para_uma_senha_forte

# ==============================================================================
# BACKUP SETTINGS (scripts/backup.sh)
# ==============================================================================
# Quantidade de cópias de snapshot compactadas mantidas no diretório de backup
BACKUP_RETENTION_COPIES=7

# Diretório onde os arquivos .tar.gz de snapshot serão armazenados
BACKUP_DIR=./backups

# Sincronização remota off-site (Regra 3-2-1): rclone, rsync ou AWS CLI / S3
# Destino remoto opcional para cópia off-site de snapshots. Se vazio, desativado.
# Exemplos:
#   rclone: "rclone:remote-name:bucket/vlogs-backups" ou "myremote:backups/victorialogs"
#   rsync/SSH: "user@backup-server.lan:/mnt/storage/vlogs-backups" ou "/mnt/nfs/backups"
#   S3: "s3://meu-bucket-s3/vlogs-backups"
# BACKUP_REMOTE_DEST=

# Ferramenta para transferência remota (auto | rclone | rsync | s3)
# 'auto': detecta pelo prefixo ("s3://" -> s3/rclone, "rclone:" ou "remote:" -> rclone, "@" ou ":" -> rsync)
# BACKUP_REMOTE_TOOL=auto

# Opções adicionais customizadas para a ferramenta remota (opcional)
# Exemplo rsync: "-e 'ssh -p 2222'" | Exemplo rclone: "--bwlimit 10M" | Exemplo s3: "--storage-class STANDARD_IA"
# BACKUP_REMOTE_EXTRA_OPTS=

# Rotação remota mantendo a mesma política de retenção local (BACKUP_RETENTION_COPIES)
# BACKUP_REMOTE_RETENTION_ENABLED=true

# ------------------------------------------------------------------------------
# VICTORIALOGS SETTINGS
# ------------------------------------------------------------------------------
# Versão da imagem Docker do VictoriaLogs
VICTORIALOGS_VERSION=latest

# Host ou IP da máquina/VM onde o VictoriaLogs está acessível para clientes
# (MCP, curl, scripts). 127.0.0.1 se a stack roda no mesmo host; senão o IP da VM.
VICTORIALOGS_HOST=127.0.0.1

# URL base completa da instância para integrações e MCP Server
VICTORIALOGS_URL=http://127.0.0.1:9428

# Porta HTTP exposta para consultas da API, ingestão e Web UI (VMUI)
VICTORIALOGS_HTTP_PORT=9428

# Período de retenção dos logs (ex: 30d, 90d, 1y). Padrão homelab: 1y (1 ano)
RETENTION_PERIOD=1y

# Porcentagem máxima de memória do container reservada para buffers/caches
VICTORIALOGS_MEMORY_ALLOWED_PERCENT=60

# ------------------------------------------------------------------------------
# VECTOR SETTINGS
# ------------------------------------------------------------------------------
# Versão da imagem Docker do Vector (versão alpine é mais leve)
VECTOR_VERSION=0.45.0-alpine

# Nível de log interno do Vector (error, warn, info, debug) - 'warn' minimiza ruído
VECTOR_LOG_LEVEL=warn

# Porta Syslog UDP para ingestão externa (hosts Proxmox, LXCs, switches)
VECTOR_SYSLOG_PORT=5140

# Porta HTTP para ingestão direta de logs via JSON POST
VECTOR_HTTP_PORT=8686

# Porta Prometheus para exportação de telemetria interna do Vector (/metrics)
VECTOR_METRICS_PORT=9598

# ------------------------------------------------------------------------------
# VMALERT SETTINGS (Opcional - docker compose --profile alerting up -d)
# ------------------------------------------------------------------------------
# Versão da imagem Docker do vmalert
VMALERT_VERSION=latest

# Porta HTTP da Web UI e telemetria do vmalert
VMALERT_HTTP_PORT=8880

# URL do Notifier para onde o vmalert despacha alertas (padrão interno: alert-bridge na porta 9093)
VMALERT_NOTIFIER_URL=http://alert-bridge:9093

# ------------------------------------------------------------------------------
# ALERT-BRIDGE SETTINGS (Notificações: ntfy, Telegram, Webhook)
# ------------------------------------------------------------------------------
# Versão da imagem Docker do alert-bridge (Alpine com Python padrão)
ALERT_BRIDGE_PYTHON_VERSION=3.14-alpine

# Porta HTTP exposta no host para o alert-bridge (API compatível com Alertmanager)
ALERT_BRIDGE_HTTP_PORT=9093

# Canais ativos (separados por vírgula: ntfy, telegram, webhook).
# Se deixado vazio, auto-detecta conforme as variáveis preenchidas abaixo.
# ALERT_CHANNELS=ntfy,telegram,webhook

# 1. ntfy (Push notification no celular ou desktop via ntfy.sh ou self-hosted)
# NTFY_URL=https://ntfy.sh/meu-homelab-alertas
# NTFY_AUTH_TOKEN=tk_meu_token_secreto
# NTFY_USER=
# NTFY_PASSWORD=

# 2. Telegram (Mensagens formatadas via Bot API)
# Crie seu bot no @BotFather e pegue o chat ID no @userinfobot
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=-1001234567890

# 3. Webhook Genérico (Discord, Slack, n8n, Home Assistant)
# WEBHOOK_URL=https://discord.com/api/webhooks/123456/abcdef...

# Intervalo mínimo antes de reenviar o mesmo alerta repetido (anti-spam/anti-flap)
ALERT_REPEAT_INTERVAL=30m
ALERT_DEDUPLICATE=true

