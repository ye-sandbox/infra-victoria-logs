# ==============================================================================
# ENVIRONMENT VARIABLES: VICTORIALOGS + VECTOR HOMELAB STACK
# ==============================================================================
# Copie este arquivo para `.env` e configure conforme seu ambiente:
# cp .env.example .env
# ==============================================================================

# Nome do projeto no Docker Compose
COMPOSE_PROJECT_NAME=observability

# Identificador do host atual nos logs (ex: mini-pc-proxmox, nuc-01)
HOST_IDENTIFIER=mini-pc-proxmox

# ==============================================================================
# STORAGE PROFILE (hdd | ssd)
# ==============================================================================
# Escolha o perfil adequado à mídia de armazenamento do seu Mini PC / Servidor:
#
# - hdd: OTIMIZADO PARA DISCOS MECÂNICOS (HD SATA / USB)
#        * Buffer do Vector em memória RAM (elimina a escrita dupla no HD)
#        * Lotes maiores (2 MB / 15s) para maximizar escrita sequencial e cortar I/O contínuo
#        * Descarte automático de pings/healthchecks para poupar IOPS
#        * Concorrência de busca reduzida para não travar a agulha de leitura
#
# - ssd: OTIMIZADO PARA SSDs / NVMes
#        * Buffer persistente em disco (256 MB) para máxima durabilidade
#        * Lotes menores (1 MB / 1s) para menor latência de visualização
#        * Ingestão completa de logs
#        * Suporta mais buscas concorrentes simultâneas
#
STORAGE_PROFILE=hdd

# Concorrência máxima de buscas no VictoriaLogs (recomendado: 2 para hdd, 4 para ssd)
VL_MAX_CONCURRENT_REQUESTS=2

# Duração máxima para abortar buscas lentas (protege contra travamentos)
VL_MAX_QUERY_DURATION=30s

# Intervalo para consolidar dados na RAM antes de descarregar peças para o disco
# Recomendado: 15s para hdd (reduz merges de pequenas peças no HD), 5s para ssd
VL_INMEMORY_FLUSH_INTERVAL=15s

# ==============================================================================
# SECURITY / BASIC AUTH (Opcional)
# ==============================================================================
# Se preenchido, protege a Web UI (VMUI), endpoint de ingestão e APIs do VictoriaLogs
# com autenticação HTTP básica. Se deixado vazio, a autenticação fica desativada.
# VICTORIALOGS_AUTH_USERNAME=admin
# VICTORIALOGS_AUTH_PASSWORD=altere_para_uma_senha_forte

# ==============================================================================
# BACKUP SETTINGS (scripts/backup.sh)
# ==============================================================================
# Quantidade de cópias de snapshot compactadas mantidas no diretório de backup
BACKUP_RETENTION_COPIES=7

# Diretório onde os arquivos .tar.gz de snapshot serão armazenados
BACKUP_DIR=./backups

# ------------------------------------------------------------------------------
# VICTORIALOGS SETTINGS
# ------------------------------------------------------------------------------
# Versão da imagem Docker do VictoriaLogs
VICTORIALOGS_VERSION=latest

# Host ou IP da máquina/VM onde o VictoriaLogs está rodando
VICTORIALOGS_HOST=192.168.0.201

# URL base completa da instância para integrações e MCP Server
VICTORIALOGS_URL=http://192.168.0.201:9428

# Porta HTTP exposta para consultas da API, ingestão e Web UI (VMUI)
VICTORIALOGS_HTTP_PORT=9428

# Período de retenção dos logs (ex: 7d, 30d, 1y)
RETENTION_PERIOD=30d

# Porcentagem máxima de memória do container reservada para buffers/caches
VICTORIALOGS_MEMORY_ALLOWED_PERCENT=60

# ------------------------------------------------------------------------------
# VECTOR SETTINGS
# ------------------------------------------------------------------------------
# Versão da imagem Docker do Vector (versão alpine é mais leve)
VECTOR_VERSION=0.45.0-alpine

# Nível de log interno do Vector (error, warn, info, debug) - 'warn' minimiza ruído
VECTOR_LOG_LEVEL=warn

# Porta Syslog UDP para ingestão externa (hosts Proxmox, LXCs, switches)
VECTOR_SYSLOG_PORT=5140

# Porta HTTP para ingestão direta de logs via JSON POST
VECTOR_HTTP_PORT=8686

# Porta Prometheus para exportação de telemetria interna do Vector (/metrics)
VECTOR_METRICS_PORT=9598
